{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Memole's World",
        "width": 1280,
        "height": 760,
        "minWidth": 1060,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "backgroundColor": "#fcf6f3"
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": true
    }
  }
}
