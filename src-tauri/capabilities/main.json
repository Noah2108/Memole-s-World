{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Archivio locale e sola scrittura del backup scelto nella finestra di salvataggio.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "store:allow-load",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "dialog:allow-save",
    "fs:allow-write-text-file",
    "fs:allow-read-text-file",
    "fs:allow-exists",
    { "identifier": "fs:scope", "allow": [{ "path": "$APPDATA/memoles-world.json" }, { "path": "$APPDATA/memoles-world-safety.json" }] }
  ]
}
