{
  "name": "memoles-world",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "description": "Memole's World — gestionale desktop per il doposcuola",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project chromium",
    "test:e2e:webkit": "playwright test --project webkit",
    "check": "npm run test && npm run build",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build:windows": "tauri build --bundles nsis",
    "desktop:build:mac": "node scripts/build-macos.mjs",
    "icons": "node scripts/icons.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-fs": "2.7.1",
    "@tauri-apps/plugin-store": "2.5.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
